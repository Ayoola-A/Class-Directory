* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f6fb;
    color: #333;
}

header {
    background: #273c75;
    color: white;
    text-align: center;
    padding: 30px 15px;
}

header h1 {
    font-size: 32px;
    margin-bottom: 8px;
}

.container {
    width: 90%;
    max-width: 850px;
    margin: 30px auto;
}

section {
    background: white;
    padding: 25px;
    margin-bottom: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.06);
}

h2 {
    margin-bottom: 20px;
    color: #273c75;
}

.form-group {
    margin-bottom: 18px;
}

label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
}

input {
    width: 100%;
    padding: 13px;
    border: 1px solid #ccc;
    border-radius: 7px;
    font-size: 15px;
    outline: none;
}

input:focus {
    border-color: #273c75;
}

button {
    background: #273c75;
    color: white;
    border: none;
    padding: 13px 22px;
    border-radius: 7px;
    cursor: pointer;
    font-size: 15px;
}

button:hover {
    background: #192a56;
}

.error {
    display: block;
    color: #d63031;
    font-size: 13px;
    margin-top: 6px;
}

.student-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    margin-top: 20px;
}

.student-card {
    background: #f1f3fa;
    border-left: 5px solid #273c75;
    padding: 20px;
    border-radius: 8px;
}

.student-card h3 {
    margin-bottom: 10px;
    color: #273c75;
}

.student-card p {
    font-size: 15px;
}

.empty-message {
    color: #777;
    text-align: center;
    padding: 15px;
}

.announcement {
    background: #e8f4ff;
    border-left: 5px solid #273c75;
}

.announcement p {
    line-height: 1.6;
}

footer {
    text-align: center;
    padding: 20px;
    background: #273c75;
    color: white;
    margin-top: 40px;
}

@media (max-width: 600px) {
    .container {
        width: 94%;
    }

    section {
        padding: 18px;
    }

    header h1 {
        font-size: 26px;
    }
}